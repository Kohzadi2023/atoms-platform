DATABASE_URL=postgresql://atoms:atoms@localhost:5432/atoms
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=

CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=3001
CONTROL_API_CORS_ORIGINS=http://localhost:3000
AUTH_REQUIRED=true
AUTH_ISSUER_URL=https://auth.example.invalid/
AUTH_AUDIENCE=atoms-control-api
AUTH_JWKS_URL=https://auth.example.invalid/.well-known/jwks.json
# AUTH_ALLOWED_ALGORITHMS=RS256
AUTH_DEV_AUTHENTICATOR_ENABLED=true
AUTH_DEV_ACCESS_TOKEN=dev-access-token
AUTH_DEV_USER_ID=dev-user
ORCHESTRATOR_CONCURRENCY=2
ATTACHMENT_SCAN_CONCURRENCY=2
# RUN_QUEUE_PREFIX=atoms

# S3-compatible encrypted attachment quarantine. The values below target the
# pinned local MinIO service in compose.yaml and are not production credentials.
S3_BUCKET=atoms-attachments
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=atoms-local
S3_SECRET_ACCESS_KEY=atoms-local-password
# Production should use a managed KMS key and a private S3 endpoint.
# S3_KMS_KEY_ID=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Phase 2 sandbox validation. The worker requires a real key in deployed use.
E2B_API_KEY=
E2B_TEMPLATE=
E2B_ALLOWED_HOSTS=registry.npmjs.org,binaries.prisma.sh
SANDBOX_IDLE_TIMEOUT_MS=900000
# Opt in only for a deliberate, potentially billable provider smoke test.
RUN_LIVE_E2B_TESTS=false

# Use a secret of at least 32 random bytes outside source control.
PREVIEW_SIGNING_SECRET=replace-with-at-least-32-random-bytes
PREVIEW_BASE_DOMAIN=preview.localhost
PREVIEW_PUBLIC_PROTOCOL=http
PREVIEW_UI_ORIGIN=http://localhost:3000
PREVIEW_GATEWAY_HOST=0.0.0.0
PREVIEW_GATEWAY_PORT=3002

# Browser-visible, non-secret web configuration.
NEXT_PUBLIC_CONTROL_API_URL=http://localhost:3001
# Local development token only; production should provide this through the app's identity SDK.
NEXT_PUBLIC_CONTROL_API_ACCESS_TOKEN=dev-access-token
NEXT_PUBLIC_PREVIEW_BASE_DOMAIN=preview.localhost

# Phase 3 generated-database provisioning is disabled unless all four secret
# inputs below are configured in the private worker environment. Never expose
# these values to apps/web, generated code, logs, or PostgreSQL.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORGANIZATION_SLUG=
SUPABASE_MANAGEMENT_API_URL=https://api.supabase.com
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
# VAULT_NAMESPACE=
# Opaque metadata only; the Control API never resolves this reference.
SUPABASE_CREDENTIAL_SECRET_REF=env://SUPABASE_ACCESS_TOKEN
DATABASE_OPERATION_CONCURRENCY=1
DATABASE_RECONCILIATION_INTERVAL_MS=300000
DATABASE_STALE_AFTER_MS=1200000
DATABASE_ORPHAN_GRACE_MS=86400000
DATABASE_ABANDONED_SWEEP_AFTER_MS=1800000
DATABASE_MAX_RECOVERY_ATTEMPTS=3
DATABASE_RECOVERY_BATCH_SIZE=100
# Report-only by default. Deletion additionally requires a persisted finding
# with two observations and exact operator approval through the private CLI.
DATABASE_APPROVED_ORPHAN_CLEANUP_ENABLED=false
# Explicit, potentially billable provider tests remain opt-in.
RUN_LIVE_SUPABASE_TESTS=false
# The legacy provider smoke also requires the exact confirmation documented in
# the staging runbook; leave blank for normal test runs.
SUPABASE_LIVE_DESTRUCTIVE_CONFIRMATION=

# Phase 3 staging evidence. These switches must remain false locally. The
# protected workflow supplies them only after its exact input checks and
# environment approval.
RUN_PHASE3_DURABILITY_INTEGRATION_TESTS=false
PHASE3_INTEGRATION_DATABASE_CONFIRMATION=
RUN_LIVE_PHASE3_STAGING=false
PHASE3_STAGING_DESTRUCTIVE_CONFIRMATION=
PHASE3_STAGING_CHANGE_TICKET=
PHASE3_STAGING_MEASURED_COST_CAD=
PHASE3_STAGING_EVIDENCE_PATH=artifacts/phase3-provider-evidence.json
PHASE3_STAGING_DATABASE_REGION=americas
PHASE3_STAGING_MIN_OTHER_ORG_CONTROLS=1
PHASE3_STAGING_MIN_CUSTOMER_CONTROLS=1
