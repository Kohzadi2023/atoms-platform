# This file contains public deployment metadata only. Copy it to an untracked
# path and keep every password, token, signing secret, and private key in the
# external ATOMS_STAGING_SECRETS_DIR described in docs/staging-deployment.md.
COMPOSE_PROJECT_NAME=atoms-staging
ATOMS_IMAGE_TAG=replace-with-the-full-40-character-git-sha
ATOMS_STAGING_SECRETS_DIR=/etc/atoms/staging/secrets

ATOMS_WEB_ORIGIN=https://app.staging.example.com
ATOMS_CONTROL_API_ORIGIN=https://api.staging.example.com
ATOMS_STORAGE_ORIGIN=https://storage.staging.example.com
ATOMS_PREVIEW_BASE_DOMAIN=preview.staging.example.com

# Microsoft Entra External ID public application metadata.
ATOMS_ENTRA_WEB_CLIENT_ID=replace-with-atoms-staging-web-client-id
ATOMS_ENTRA_AUTHORITY=https://your-tenant-subdomain.ciamlogin.com/
ATOMS_ENTRA_API_SCOPE=api://replace-with-control-api-client-id/access_as_user
# Control API OIDC validation metadata. Resolve issuer + jwks_uri from the
# external tenant's v2.0 OpenID configuration instead of guessing them.
ATOMS_AUTH_ISSUER_URL=https://your-tenant-subdomain.ciamlogin.com/replace-with-tenant-id/v2.0
ATOMS_AUTH_AUDIENCE=replace-with-control-api-client-id
ATOMS_AUTH_JWKS_URL=https://your-tenant-subdomain.ciamlogin.com/replace-with-tenant-id/discovery/v2.0/keys
ATOMS_AUTH_ALLOWED_ALGORITHMS=RS256

ATOMS_POSTGRES_DB=atoms
ATOMS_POSTGRES_USER=atoms
ATOMS_S3_BUCKET=atoms-attachments
ATOMS_S3_REGION=us-east-1
ATOMS_RUN_QUEUE_PREFIX=atoms-staging
ATOMS_ORCHESTRATOR_CONCURRENCY=2
ATOMS_ATTACHMENT_SCAN_CONCURRENCY=2
ATOMS_E2B_ALLOWED_HOSTS=registry.npmjs.org,binaries.prisma.sh
# Separate provider integration for generated-app database provisioning.
ATOMS_SUPABASE_MANAGEMENT_API_URL=https://api.supabase.com
