{
  "name": "atoms-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-agent vibe business and coding platform",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "ci:verify": "pnpm verify && pnpm test:local-development && pnpm test:phase3-environment-protection && pnpm test:azure-staging && pnpm test:staging-deployment && pnpm sql:lint && pnpm audit --audit-level high && pnpm secrets:scan",
    "dev": "pnpm dev:check && node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --env-mode=loose",
    "dev:check": "node --env-file-if-exists=.env scripts/check-local-development.mjs",
    "dev:web": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --filter=@atoms/web --env-mode=loose",
    "demo:phase2": "node scripts/demo-phase2.mjs",
    "demo:phase3": "node scripts/demo-phase3.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm build && pnpm test && pnpm typecheck && pnpm db:validate",
    "prisma": "prisma --config ./prisma.config.ts",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "sql:lint": "node scripts/lint-sql.mjs",
    "staging:phase3:preflight": "node scripts/preflight-phase3-staging.mjs",
    "staging:phase3:preflight:live": "node scripts/preflight-phase3-staging.mjs --live",
    "staging:phase3:preflight:json": "node scripts/preflight-phase3-staging.mjs --json --out artifacts/phase3-preflight-durability.json",
    "staging:phase3:preflight:live:json": "node scripts/preflight-phase3-staging.mjs --live --json --out artifacts/phase3-preflight-live.json",
    "staging:phase3:environment-protection": "node scripts/verify-phase3-environment-protection.mjs",
    "staging:phase3:durability": "pnpm build && pnpm --filter @atoms/orchestrator-worker test:phase3-durability:built",
    "staging:phase3:provider": "pnpm build && pnpm --filter @atoms/orchestrator-worker test:phase3-provider-exit:built",
    "staging:attachments:durability": "pnpm build && pnpm --filter @atoms/control-api test:attachments-durability:built",
    "staging:attachments:storage": "pnpm build && pnpm --filter @atoms/storage-provider test:storage-integration:built",
    "staging:deploy:preflight": "node scripts/check-staging-deployment.mjs",
    "staging:deploy:compose:validate": "node scripts/validate-staging-compose.mjs",
    "staging:deploy:persistence:bootstrap": "node scripts/bootstrap-staging-persistence.mjs",
    "staging:deploy:recovery:rehearse": "node scripts/rehearse-staging-recovery.mjs",
    "staging:smoke:authenticated": "node scripts/smoke-staging-authenticated.mjs",
    "staging:azure:inputs:validate": "node scripts/validate-azure-staging-inputs.mjs",
    "db:generate": "pnpm prisma generate",
    "db:validate": "pnpm prisma validate",
    "db:format": "pnpm prisma format",
    "db:migrate:dev": "pnpm prisma migrate dev",
    "db:migrate:deploy": "pnpm prisma migrate deploy",
    "db:seed:local": "pnpm --filter @atoms/db seed:local",
    "test:local-development": "node --test scripts/check-local-development.test.mjs",
    "test:phase3-environment-protection": "node --test scripts/validate-phase3-staging-inputs.test.mjs scripts/verify-phase3-environment-protection.test.mjs",
    "test:azure-staging": "node --test scripts/validate-azure-staging-inputs.test.mjs",
    "test:staging-deployment": "node --test scripts/check-staging-deployment.test.mjs scripts/bootstrap-staging-persistence.test.mjs scripts/smoke-staging-authenticated.test.mjs scripts/rehearse-staging-recovery.test.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "prisma": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
