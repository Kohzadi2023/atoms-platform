{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_CONTROL_API_ACCESS_TOKEN",
        "NEXT_PUBLIC_CONTROL_API_URL",
        "NEXT_PUBLIC_ENTRA_CLIENT_ID",
        "NEXT_PUBLIC_ENTRA_AUTHORITY",
        "NEXT_PUBLIC_ENTRA_TENANT_ID",
        "NEXT_PUBLIC_ENTRA_API_SCOPE",
        "NEXT_PUBLIC_PREVIEW_BASE_DOMAIN",
        "NEXT_PUBLIC_STORAGE_ORIGIN"
      ],
      "outputs": [
        "dist/**",
        "src/generated/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
