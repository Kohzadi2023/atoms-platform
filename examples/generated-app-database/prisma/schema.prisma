generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(320)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("accounts")
}
