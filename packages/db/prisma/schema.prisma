generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum AgentName {
  Sophia
  Mike
  Emma
  Bob
  Alex
  David
  Sarah
  Adrian
  CustomerSuccess
}

enum AgentRunStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentTaskStatus {
  PENDING
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum SandboxProviderType {
  E2B
}

enum SandboxSessionStatus {
  PROVISIONING
  VALIDATING
  READY
  FAILED
  TERMINATED
  EXPIRED
}

enum SandboxCommandName {
  INSTALL
  PRISMA_VALIDATE
  LINT
  TYPECHECK
  TEST
  BUILD
  PREVIEW_START
  PREVIEW_HEALTH
}

enum SandboxCommandStatus {
  SUCCEEDED
  FAILED
}

enum PreviewSessionStatus {
  READY
  STOPPED
  EXPIRED
  ERROR
}

enum ProjectAttachmentStatus {
  AWAITING_UPLOAD
  QUARANTINED
  SCANNING
  CLEAN
  REJECTED
  FAILED
  EXPIRED
}

enum BillingProvider {
  STRIPE
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  UNPAID
  CANCELED
}

enum DatabaseProvider {
  SUPABASE
  NEON
  EXTERNAL
}

enum DatabaseInstanceStatus {
  QUEUED
  PROVISIONING
  HEALTH_CHECK
  MIGRATING
  READY
  ACTIVE
  SUSPENDED
  FAILED
  DELETING
  DELETED
}

enum IntegrationProvider {
  SUPABASE
}

enum IntegrationConnectionStatus {
  CONNECTED
  REVOKED
  ERROR
}

enum SecretStoreProvider {
  VAULT
}

enum SecretReferencePurpose {
  PROVIDER_CREDENTIAL
  DATABASE_RUNTIME
  DATABASE_MIGRATION
}

enum SecretReferenceStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MigrationArtifactStatus {
  VALIDATED
  SUPERSEDED
}

enum MigrationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
}

enum DatabaseReconciliationSweepStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum DatabaseReconciliationFindingKind {
  PROVIDER_RESOURCE_MISSING
  ORPHAN_PROVIDER_RESOURCE
  RECOVERY_EXHAUSTED
}

enum DatabaseReconciliationFindingStatus {
  OPEN
  APPROVED
  CLEANING
  RESOLVED
  IGNORED
}

enum DeploymentProvider {
  VERCEL
  EXTERNAL
}

enum DeploymentEnvironment {
  PREVIEW
  PRODUCTION
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  READY
  ERROR
  CANCELED
}

// Additive per the PR #70 QA & Release observe-only wiring: persistence for
// @atoms/quality's deterministic ReleaseAssessment output. Nothing above this
// enum is touched; these are new types only.
enum ReleaseAssessmentStatus {
  READY
  BLOCKED
}

// Which caller produced an assessment. Kept as part of the natural key
// (alongside runId/controlVersion/attempt) because a control-api on-demand
// trigger and the worker's own automatic assessment can otherwise target the
// exact same attempt (attempt 1, the common case for a run's first try),
// silently overwriting each other and losing provenance.
enum ReleaseAssessmentSource {
  WORKER
  MANUAL
}

enum ReleaseEvidenceKind {
  LINT
  TYPECHECK
  TEST
  BUILD
  REGRESSION
  E2E
  ACCESSIBILITY
  PERFORMANCE
  SECURITY
  ACCEPTANCE
}

enum ReleaseEvidenceStatus {
  PASSED
  FAILED
  SKIPPED
  ERROR
}

model Workspace {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String                  @db.VarChar(160)
  slug                   String                  @unique @db.VarChar(80)
  memberships            Membership[]
  projects               Project[]
  subscriptions          Subscription[]
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(3)
  integrationConnections IntegrationConnection[]
  secretReferences       SecretReference[]
  gtmScopes              GtmScope[]

  @@map("workspaces")
}

model Membership {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  userId      String         @map("user_id") @db.VarChar(191)
  role        MembershipRole @default(MEMBER)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Project {
  id                     String                  @id @default(uuid()) @db.Uuid
  workspaceId            String                  @map("workspace_id") @db.Uuid
  name                   String                  @db.VarChar(160)
  slug                   String                  @db.VarChar(100)
  description            String?                 @db.Text
  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files                  ProjectFile[]
  attachments            ProjectAttachment[]
  runs                   AgentRun[]
  sandboxSessions        SandboxSession[]
  previewSessions        PreviewSession[]
  databaseInstances      DatabaseInstance[]
  integrationConnections IntegrationConnection[]
  secretReferences       SecretReference[]
  migrationArtifacts     MigrationArtifact[]
  deployments            Deployment[]
  releaseAssessments     ReleaseAssessment[]
  // At most one row in practice (a project-scoped GtmScope is enforced unique
  // per project by a raw-SQL partial index in the migration, invisible to
  // Prisma's own schema types, so the relation is still declared as a list).
  gtmScopes              GtmScope[]
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt             DateTime?               @map("archived_at") @db.Timestamptz(3)

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@map("projects")
}

model ProjectFile {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  filePath  String   @map("file_path") @db.VarChar(1024)
  content   String   @db.Text
  version   Int      @default(1)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([projectId, filePath, version])
  @@index([projectId, filePath, createdAt])
  @@map("project_files")
}

model AgentRun {
  id                 String               @id @default(uuid()) @db.Uuid
  workspaceId        String               @map("workspace_id") @db.Uuid
  projectId          String               @map("project_id") @db.Uuid
  idempotencyKey     String?              @map("idempotency_key") @db.VarChar(191)
  status             AgentRunStatus       @default(PENDING)
  prompt             String               @db.Text
  checkpoint         Json?
  error              Json?
  eventSequence      Int                  @default(0) @map("event_sequence")
  controlVersion     Int                  @default(0) @map("control_version")
  project            Project              @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  tasks              AgentTask[]
  events             RunEvent[]
  sandboxSessions    SandboxSession[]
  previewSessions    PreviewSession[]
  migrationArtifacts MigrationArtifact[]
  attachments        AgentRunAttachment[]
  releaseAssessments ReleaseAssessment[]
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt          DateTime?            @map("started_at") @db.Timestamptz(3)
  pausedAt           DateTime?            @map("paused_at") @db.Timestamptz(3)
  completedAt        DateTime?            @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  lastHeartbeatAt    DateTime?            @map("last_heartbeat_at") @db.Timestamptz(3)

  @@index([workspaceId, status, createdAt])
  @@index([projectId, createdAt])
  @@unique([projectId, idempotencyKey])
  @@map("agent_runs")
}

model ProjectAttachment {
  id                  String                  @id @default(uuid()) @db.Uuid
  workspaceId         String                  @map("workspace_id") @db.Uuid
  projectId           String                  @map("project_id") @db.Uuid
  fileName            String                  @map("file_name") @db.VarChar(255)
  declaredContentType String                  @map("declared_content_type") @db.VarChar(100)
  detectedContentType String?                 @map("detected_content_type") @db.VarChar(100)
  sizeBytes           Int                     @map("size_bytes")
  quarantineObjectKey String                  @unique @map("quarantine_object_key") @db.VarChar(1024)
  cleanObjectKey      String?                 @unique @map("clean_object_key") @db.VarChar(1024)
  etag                String?                 @db.VarChar(512)
  sha256              String?                 @db.Char(64)
  status              ProjectAttachmentStatus @default(AWAITING_UPLOAD)
  scanVersion         Int                     @default(0) @map("scan_version")
  failureCode         String?                 @map("failure_code") @db.VarChar(100)
  scanMetadata        Json?                   @map("scan_metadata")
  uploadExpiresAt     DateTime                @map("upload_expires_at") @db.Timestamptz(3)
  scannedAt           DateTime?               @map("scanned_at") @db.Timestamptz(3)
  project             Project                 @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  runs                AgentRunAttachment[]
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([projectId, status, createdAt])
  @@index([workspaceId, status, uploadExpiresAt])
  @@map("project_attachments")
}

model AgentRunAttachment {
  runId        String            @map("run_id") @db.Uuid
  attachmentId String            @map("attachment_id") @db.Uuid
  fileName     String            @map("file_name") @db.VarChar(255)
  contentType  String            @map("content_type") @db.VarChar(100)
  sizeBytes    Int               @map("size_bytes")
  sha256       String            @db.Char(64)
  objectKey    String            @map("object_key") @db.VarChar(1024)
  run          AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  attachment   ProjectAttachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([runId, attachmentId])
  @@index([attachmentId])
  @@map("agent_run_attachments")
}

model AgentTask {
  id                String             @id @default(uuid()) @db.Uuid
  runId             String             @map("run_id") @db.Uuid
  agentName         AgentName          @map("agent_name")
  description       String             @db.Text
  status            AgentTaskStatus    @default(PENDING)
  ordinal           Int
  attempt           Int                @default(0)
  input             Json?
  output            Json?
  error             Json?
  run               AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  migrationArtifact MigrationArtifact?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt         DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(3)

  @@unique([runId, ordinal])
  @@index([runId, status])
  @@index([agentName, status])
  @@map("agent_tasks")
}

model RunEvent {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  sequence  Int
  eventType String   @map("event_type") @db.VarChar(100)
  payload   Json
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@map("run_events")
}

model SandboxSession {
  id           String               @id @default(uuid()) @db.Uuid
  workspaceId  String               @map("workspace_id") @db.Uuid
  projectId    String               @map("project_id") @db.Uuid
  runId        String               @map("run_id") @db.Uuid
  provider     SandboxProviderType  @default(E2B)
  externalId   String               @map("external_id") @db.VarChar(191)
  attempt      Int
  status       SandboxSessionStatus @default(PROVISIONING)
  expiresAt    DateTime             @map("expires_at") @db.Timestamptz(3)
  error        Json?
  run          AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  commands     SandboxCommand[]
  preview      PreviewSession?
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  terminatedAt DateTime?            @map("terminated_at") @db.Timestamptz(3)

  @@unique([runId, attempt])
  @@unique([provider, externalId])
  @@index([workspaceId, status, expiresAt])
  @@index([projectId, createdAt])
  @@map("sandbox_sessions")
}

model SandboxCommand {
  id               String               @id @default(uuid()) @db.Uuid
  sandboxSessionId String               @map("sandbox_session_id") @db.Uuid
  ordinal          Int
  name             SandboxCommandName
  command          String               @db.VarChar(32768)
  status           SandboxCommandStatus
  exitCode         Int                  @map("exit_code")
  stdout           String               @db.Text
  stderr           String               @db.Text
  durationMs       Int                  @map("duration_ms")
  sandboxSession   SandboxSession       @relation(fields: [sandboxSessionId], references: [id], onDelete: Cascade)
  startedAt        DateTime             @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime             @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([sandboxSessionId, ordinal])
  @@index([sandboxSessionId, status])
  @@map("sandbox_commands")
}

model PreviewSession {
  id               String               @id @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  projectId        String               @map("project_id") @db.Uuid
  runId            String               @map("run_id") @db.Uuid
  sandboxSessionId String               @unique @map("sandbox_session_id") @db.Uuid
  status           PreviewSessionStatus @default(READY)
  gatewayUrl       String               @map("gateway_url") @db.VarChar(2048)
  processId        Int                  @map("process_id")
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(3)
  run              AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  project          Project              @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  sandboxSession   SandboxSession       @relation(fields: [sandboxSessionId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  readyAt          DateTime             @map("ready_at") @db.Timestamptz(3)
  stoppedAt        DateTime?            @map("stopped_at") @db.Timestamptz(3)
  error            Json?

  @@index([workspaceId, status, expiresAt])
  @@index([projectId, createdAt])
  @@index([runId, createdAt])
  @@map("preview_sessions")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  workspaceId            String             @map("workspace_id") @db.Uuid
  provider               BillingProvider    @default(STRIPE)
  providerCustomerId     String             @map("provider_customer_id") @db.VarChar(191)
  providerSubscriptionId String             @map("provider_subscription_id") @db.VarChar(191)
  planKey                String             @map("plan_key") @db.VarChar(100)
  status                 SubscriptionStatus @default(INCOMPLETE)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  metadata               Json?
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerSubscriptionId])
  @@index([workspaceId, status])
  @@index([provider, providerCustomerId])
  @@map("subscriptions")
}

model DatabaseInstance {
  id                        String                          @id @default(uuid()) @db.Uuid
  operationId               String                          @unique @default(uuid()) @map("operation_id") @db.Uuid
  workspaceId               String                          @map("workspace_id") @db.Uuid
  projectId                 String                          @map("project_id") @db.Uuid
  migrationArtifactId       String?                         @map("migration_artifact_id") @db.Uuid
  integrationConnectionId   String?                         @map("integration_connection_id") @db.Uuid
  provider                  DatabaseProvider
  externalId                String?                         @map("external_id") @db.VarChar(191)
  idempotencyKey            String                          @unique @map("idempotency_key") @db.VarChar(191)
  displayName               String                          @map("display_name") @db.VarChar(160)
  databaseName              String?                         @map("database_name") @db.VarChar(160)
  region                    String?                         @db.VarChar(80)
  connectionSecretRef       String?                         @unique @map("connection_secret_ref") @db.VarChar(512)
  status                    DatabaseInstanceStatus          @default(QUEUED)
  operationVersion          Int                             @default(0) @map("operation_version")
  attempt                   Int                             @default(0)
  recoveryCount             Int                             @default(0) @map("recovery_count")
  error                     Json?
  metadata                  Json?
  providerOperationMetadata Json?                           @map("provider_operation_metadata")
  project                   Project                         @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  migrationArtifact         MigrationArtifact?              @relation(fields: [migrationArtifactId], references: [id], onDelete: Restrict)
  integrationConnection     IntegrationConnection?          @relation(fields: [integrationConnectionId], references: [id], onDelete: SetNull)
  connectionSecret          SecretReference?                @relation(fields: [connectionSecretRef], references: [reference], onDelete: SetNull)
  migrationRuns             MigrationRun[]
  reconciliationFindings    DatabaseReconciliationFinding[]
  createdAt                 DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastSyncedAt              DateTime?                       @map("last_synced_at") @db.Timestamptz(3)
  lastHeartbeatAt           DateTime?                       @map("last_heartbeat_at") @db.Timestamptz(3)
  lastReconciledAt          DateTime?                       @map("last_reconciled_at") @db.Timestamptz(3)
  readyAt                   DateTime?                       @map("ready_at") @db.Timestamptz(3)
  deletedAt                 DateTime?                       @map("deleted_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([workspaceId, status])
  @@index([projectId, status])
  @@index([status, lastHeartbeatAt])
  @@map("database_instances")
}

model IntegrationConnection {
  id                     String                      @id @default(uuid()) @db.Uuid
  workspaceId            String                      @map("workspace_id") @db.Uuid
  projectId              String                      @map("project_id") @db.Uuid
  provider               IntegrationProvider
  status                 IntegrationConnectionStatus @default(CONNECTED)
  externalAccountId      String?                     @map("external_account_id") @db.VarChar(191)
  externalOrganizationId String?                     @map("external_organization_id") @db.VarChar(191)
  credentialSecretRef    String                      @map("credential_secret_ref") @db.VarChar(512)
  metadata               Json?
  workspace              Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                Project                     @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  databaseInstances      DatabaseInstance[]
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  revokedAt              DateTime?                   @map("revoked_at") @db.Timestamptz(3)

  @@unique([projectId, provider])
  @@index([workspaceId, provider, status])
  @@map("integration_connections")
}

model SecretReference {
  id               String                 @id @default(uuid()) @db.Uuid
  workspaceId      String                 @map("workspace_id") @db.Uuid
  projectId        String                 @map("project_id") @db.Uuid
  provider         SecretStoreProvider
  purpose          SecretReferencePurpose
  status           SecretReferenceStatus  @default(ACTIVE)
  reference        String                 @unique @db.VarChar(512)
  expiresAt        DateTime?              @map("expires_at") @db.Timestamptz(3)
  metadata         Json?
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project                @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  databaseInstance DatabaseInstance?
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  revokedAt        DateTime?              @map("revoked_at") @db.Timestamptz(3)

  @@index([workspaceId, status, expiresAt])
  @@index([projectId, purpose])
  @@map("secret_references")
}

model MigrationArtifact {
  id                String                  @id @default(uuid()) @db.Uuid
  workspaceId       String                  @map("workspace_id") @db.Uuid
  projectId         String                  @map("project_id") @db.Uuid
  sourceRunId       String                  @map("source_run_id") @db.Uuid
  agentTaskId       String                  @unique @map("agent_task_id") @db.Uuid
  status            MigrationArtifactStatus @default(VALIDATED)
  schemaPath        String                  @map("schema_path") @db.VarChar(1024)
  schemaHash        String                  @map("schema_hash") @db.Char(64)
  migrationPaths    Json                    @map("migration_paths")
  seedPath          String                  @map("seed_path") @db.VarChar(1024)
  destructive       Boolean                 @default(false)
  policyReport      Json                    @map("policy_report")
  project           Project                 @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  sourceRun         AgentRun                @relation(fields: [sourceRunId], references: [id], onDelete: Cascade)
  agentTask         AgentTask               @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  databaseInstances DatabaseInstance[]
  migrationRuns     MigrationRun[]
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([projectId, status, createdAt])
  @@index([sourceRunId])
  @@map("migration_artifacts")
}

model MigrationRun {
  id                  String             @id @default(uuid()) @db.Uuid
  databaseInstanceId  String             @map("database_instance_id") @db.Uuid
  migrationArtifactId String             @map("migration_artifact_id") @db.Uuid
  status              MigrationRunStatus @default(QUEUED)
  schemaHash          String             @map("schema_hash") @db.Char(64)
  destructive         Boolean            @default(false)
  commandResults      Json?              @map("command_results")
  error               Json?
  databaseInstance    DatabaseInstance   @relation(fields: [databaseInstanceId], references: [id], onDelete: Cascade)
  migrationArtifact   MigrationArtifact  @relation(fields: [migrationArtifactId], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt           DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?          @map("completed_at") @db.Timestamptz(3)

  @@unique([databaseInstanceId, migrationArtifactId])
  @@index([status, createdAt])
  @@map("migration_runs")
}

model DatabaseReconciliationSweep {
  id                String                            @id @default(uuid()) @db.Uuid
  provider          DatabaseProvider
  status            DatabaseReconciliationSweepStatus @default(RUNNING)
  dryRun            Boolean                           @default(true) @map("dry_run")
  staleBefore       DateTime                          @map("stale_before") @db.Timestamptz(3)
  orphanGraceBefore DateTime                          @map("orphan_grace_before") @db.Timestamptz(3)
  summary           Json?
  error             Json?
  findings          DatabaseReconciliationFinding[]
  startedAt         DateTime                          @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?                         @map("completed_at") @db.Timestamptz(3)

  @@index([provider, status, startedAt])
  @@map("database_reconciliation_sweeps")
}

model DatabaseReconciliationFinding {
  id                 String                              @id @default(uuid()) @db.Uuid
  fingerprint        String                              @unique @db.Char(64)
  sweepId            String                              @map("sweep_id") @db.Uuid
  provider           DatabaseProvider
  kind               DatabaseReconciliationFindingKind
  status             DatabaseReconciliationFindingStatus @default(OPEN)
  databaseInstanceId String?                             @map("database_instance_id") @db.Uuid
  externalId         String?                             @map("external_id") @db.VarChar(191)
  resourceName       String?                             @map("resource_name") @db.VarChar(160)
  details            Json
  observationCount   Int                                 @default(1) @map("observation_count")
  firstSeenAt        DateTime                            @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt         DateTime                            @map("last_seen_at") @db.Timestamptz(3)
  cleanupAfter       DateTime?                           @map("cleanup_after") @db.Timestamptz(3)
  approvedBy         String?                             @map("approved_by") @db.VarChar(191)
  approvedAt         DateTime?                           @map("approved_at") @db.Timestamptz(3)
  resolvedAt         DateTime?                           @map("resolved_at") @db.Timestamptz(3)
  resolution         String?                             @db.VarChar(100)
  sweep              DatabaseReconciliationSweep         @relation(fields: [sweepId], references: [id], onDelete: Restrict)
  databaseInstance   DatabaseInstance?                   @relation(fields: [databaseInstanceId], references: [id], onDelete: SetNull)
  createdAt          DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([provider, kind, status, cleanupAfter])
  @@index([databaseInstanceId, status])
  @@index([sweepId])
  @@map("database_reconciliation_findings")
}

model Deployment {
  id                String                @id @default(uuid()) @db.Uuid
  workspaceId       String                @map("workspace_id") @db.Uuid
  projectId         String                @map("project_id") @db.Uuid
  provider          DeploymentProvider    @default(VERCEL)
  externalId        String                @map("external_id") @db.VarChar(191)
  externalProjectId String?               @map("external_project_id") @db.VarChar(191)
  providerTeamId    String?               @map("provider_team_id") @db.VarChar(191)
  idempotencyKey    String                @unique @map("idempotency_key") @db.VarChar(191)
  environment       DeploymentEnvironment
  status            DeploymentStatus      @default(QUEUED)
  url               String?               @db.VarChar(2048)
  sourceRevision    String?               @map("source_revision") @db.VarChar(191)
  metadata          Json?
  project           Project               @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  readyAt           DateTime?             @map("ready_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([workspaceId, environment, status])
  @@index([projectId, createdAt])
  @@map("deployments")
}

// Persisted output of @atoms/quality's pure, observe-only evaluateRelease().
// One row per (run, controlVersion, worker attempt) observation. mode is
// always OBSERVE_ONLY today: this is a recorded assessment, never a
// deployment or run-completion gate.
model ReleaseAssessment {
  id                String                  @id @default(uuid()) @db.Uuid
  workspaceId       String                  @map("workspace_id") @db.Uuid
  projectId         String                  @map("project_id") @db.Uuid
  runId             String                  @map("run_id") @db.Uuid
  controlVersion    Int                     @map("control_version")
  attempt           Int
  source            ReleaseAssessmentSource @default(WORKER)
  snapshotSha256    String                  @map("snapshot_sha256") @db.Char(64)
  status            ReleaseAssessmentStatus
  acceptanceTaskId  String?                 @map("acceptance_task_id") @db.Uuid
  policy            Json
  checks            Json
  traceToAcceptance Json                    @map("trace_to_acceptance")
  issues            Json
  evaluatedAt       DateTime                @map("evaluated_at") @db.Timestamptz(3)
  project           Project                 @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  run               AgentRun                @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence          ReleaseEvidence[]
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([runId, controlVersion, attempt, source])
  @@index([workspaceId, projectId, createdAt])
  @@index([runId, createdAt])
  @@map("release_assessments")
}

// One row per QualityEvidence record accepted into an assessment. Purely
// structured references (ids, kind, status, criterion ids) -- never raw
// command output, logs, or credentials.
model ReleaseEvidence {
  id                    String                @id @default(uuid()) @db.Uuid
  assessmentId          String                @map("assessment_id") @db.Uuid
  sourceArtifactId      String                @map("source_artifact_id") @db.Uuid
  kind                  ReleaseEvidenceKind
  status                ReleaseEvidenceStatus
  completedAt           DateTime              @map("completed_at") @db.Timestamptz(3)
  acceptanceTaskId      String?               @map("acceptance_task_id") @db.Uuid
  acceptanceTaskAttempt Int?                  @map("acceptance_task_attempt")
  criterionIds          Json                  @map("criterion_ids")
  assessment            ReleaseAssessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([assessmentId])
  @@map("release_evidence")
}

// Revenue & GTM data foundation for Sophia (data model + contracts only in
// this increment -- no control-api routes, no Sophia manifest/schema wiring,
// no live Apollo/HubSpot calls; see packages/revenue for the adapter
// interfaces). GtmScope is the single source of truth for the PLATFORM_GTM
// (sells Atoms itself) vs PROJECT_GTM (sells one customer-generated product)
// tenant boundary; every other GTM table FKs to gtmScopeId only and never
// re-derives workspaceId/projectId, the same way ReleaseEvidence FKs to
// ReleaseAssessment rather than duplicating its scope fields.
enum GtmMode {
  PLATFORM_GTM
  PROJECT_GTM
}

model GtmScope {
  id             String             @id @default(uuid()) @db.Uuid
  workspaceId    String             @map("workspace_id") @db.Uuid
  // Required iff mode = PROJECT_GTM; enforced by a raw-SQL CHECK constraint
  // in the migration (Prisma cannot express a conditionally-required field).
  projectId      String?            @map("project_id") @db.Uuid
  mode           GtmMode
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project?           @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  prospects      Prospect[]
  sequences      OutreachSequence[]
  suppressions   SuppressionEntry[]
  crmSyncRecords CrmSyncRecord[]
  deals          Deal[]
  customerSuccessHandoffs CustomerSuccessHandoff[]
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([workspaceId])
  @@index([projectId])
  // Per-mode uniqueness (at most one PLATFORM_GTM scope per workspace; at
  // most one scope per project) is enforced by two partial unique indexes
  // added via raw SQL in the migration, not @@unique -- see migration.sql.
  @@map("gtm_scopes")
}

// Reuses Sophia/CustomerSuccess's existing evidence vocabulary.
enum EvidenceStatus {
  EVIDENCED
  ASSUMPTION
  RESEARCH_REQUIRED
}

enum ProspectSource {
  APOLLO
  MANUAL
}

enum ProspectStatus {
  DISCOVERED
  ENRICHED
  QUALIFIED
  OUTREACH_READY
  IN_SEQUENCE
  CUSTOMER
  DISQUALIFIED
  SUPPRESSED
}

enum LeadScoreBand {
  COLD
  WARM
  HOT
}

model Prospect {
  id                   String          @id @default(uuid()) @db.Uuid
  gtmScopeId           String          @map("gtm_scope_id") @db.Uuid
  companyName          String          @map("company_name") @db.VarChar(160)
  companyDomain        String?         @map("company_domain") @db.VarChar(255)
  contactName          String          @map("contact_name") @db.VarChar(160)
  contactEmail         String          @map("contact_email") @db.VarChar(320)
  // Lowercased/trimmed contactEmail; the suppression-list join key.
  normalizedEmail      String          @map("normalized_email") @db.VarChar(320)
  contactTitle         String?         @map("contact_title") @db.VarChar(160)
  industry             String?         @db.VarChar(160)
  companySizeHeadcount Int?            @map("company_size_headcount")
  useCase              String          @map("use_case") @db.Text
  fitEvidenceStatus    EvidenceStatus  @map("fit_evidence_status")
  fitEvidenceNotes     String?         @map("fit_evidence_notes") @db.Text
  source               ProspectSource
  sourceExternalId     String?         @map("source_external_id") @db.VarChar(191)
  status               ProspectStatus  @default(DISCOVERED)
  // Denormalized cache of the latest LeadScore, for cheap listing/sorting;
  // LeadScore itself remains the source-of-truth history table.
  currentScore         Int?            @map("current_score")
  currentScoreBand     LeadScoreBand?  @map("current_score_band")
  gtmScope             GtmScope        @relation(fields: [gtmScopeId], references: [id], onDelete: Cascade)
  leadScores           LeadScore[]
  outreachEvents       OutreachEvent[]
  deals                Deal[]
  customerSuccessHandoffs CustomerSuccessHandoff[]
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([gtmScopeId, normalizedEmail])
  @@unique([gtmScopeId, source, sourceExternalId])
  @@index([gtmScopeId, status])
  @@map("prospects")
}

model LeadScore {
  id             String        @id @default(uuid()) @db.Uuid
  prospectId     String        @map("prospect_id") @db.Uuid
  score          Int
  band           LeadScoreBand
  scoringVersion String        @map("scoring_version") @db.VarChar(20)
  rationale      Json
  computedAt     DateTime      @map("computed_at") @db.Timestamptz(3)
  prospect       Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([prospectId, computedAt])
  @@map("lead_scores")
}

enum OutreachSequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OutreachChannel {
  EMAIL
  LINKEDIN
  CALL
}

enum OutreachEventKind {
  QUEUED
  SENT
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
  SUPPRESSED
}

model OutreachSequence {
  id         String                 @id @default(uuid()) @db.Uuid
  gtmScopeId String                 @map("gtm_scope_id") @db.Uuid
  name       String                 @db.VarChar(160)
  status     OutreachSequenceStatus @default(DRAFT)
  // Ordered [{ordinal, channel, templateRef, waitDays}].
  steps      Json
  gtmScope   GtmScope               @relation(fields: [gtmScopeId], references: [id], onDelete: Cascade)
  events     OutreachEvent[]
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([gtmScopeId, name])
  @@index([gtmScopeId, status])
  @@map("outreach_sequences")
}

model OutreachEvent {
  id                String            @id @default(uuid()) @db.Uuid
  sequenceId        String            @map("sequence_id") @db.Uuid
  prospectId        String            @map("prospect_id") @db.Uuid
  stepOrdinal       Int               @map("step_ordinal")
  channel           OutreachChannel
  kind              OutreachEventKind
  providerMessageId String?           @map("provider_message_id") @db.VarChar(191)
  occurredAt        DateTime          @map("occurred_at") @db.Timestamptz(3)
  metadata          Json?
  sequence          OutreachSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  prospect          Prospect          @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  // The anti-duplicate-send constraint the roadmap requires: the same
  // prospect can never be sent the same sequence step twice.
  @@unique([sequenceId, prospectId, stepOrdinal])
  @@index([prospectId, kind])
  @@index([sequenceId, occurredAt])
  @@map("outreach_events")
}

enum SuppressionChannel {
  EMAIL
  LINKEDIN
  ALL
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  COMPLAINT
  MANUAL
  LEGAL_HOLD
}

model SuppressionEntry {
  id                   String             @id @default(uuid()) @db.Uuid
  gtmScopeId           String             @map("gtm_scope_id") @db.Uuid
  channel              SuppressionChannel
  normalizedIdentifier String             @map("normalized_identifier") @db.VarChar(320)
  reason               SuppressionReason
  gtmScope             GtmScope           @relation(fields: [gtmScopeId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([gtmScopeId, channel, normalizedIdentifier])
  @@map("suppression_entries")
}

// A CRM sync target. Deliberately its own enum rather than reusing
// IntegrationProvider (which tracks project-level provider connections and
// is unrelated to which providers can receive a CRM sync) -- Apollo is a
// prospecting/enrichment provider, never a CRM sync target.
enum CrmSyncProvider {
  HUBSPOT
}

enum CrmEntityType {
  CONTACT
  COMPANY
  DEAL
}

enum CrmSyncStatus {
  PENDING
  SYNCED
  FAILED
  CONFLICT
}

model CrmSyncRecord {
  id            String              @id @default(uuid()) @db.Uuid
  gtmScopeId    String              @map("gtm_scope_id") @db.Uuid
  provider      CrmSyncProvider
  entityType    CrmEntityType       @map("entity_type")
  // Set iff entityType IN (CONTACT, COMPANY); raw-SQL CHECK in the migration.
  prospectId    String?             @map("prospect_id") @db.Uuid
  // Set iff entityType = DEAL; raw-SQL CHECK in the migration.
  dealId        String?             @map("deal_id") @db.Uuid
  externalId    String?             @map("external_id") @db.VarChar(191)
  status        CrmSyncStatus       @default(PENDING)
  lastSyncedAt  DateTime?           @map("last_synced_at") @db.Timestamptz(3)
  lastAttemptAt DateTime?           @map("last_attempt_at") @db.Timestamptz(3)
  error         Json?
  gtmScope      GtmScope            @relation(fields: [gtmScopeId], references: [id], onDelete: Cascade)
  deal          Deal?               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Raw-SQL additions in the migration:
  //   CHECK ((entity_type = 'DEAL' AND deal_id IS NOT NULL AND prospect_id IS NULL)
  //       OR (entity_type <> 'DEAL' AND prospect_id IS NOT NULL AND deal_id IS NULL))
  //   Partial unique indexes: (provider, prospect_id) WHERE entity_type <> 'DEAL'
  //                           (provider, deal_id) WHERE entity_type = 'DEAL'
  @@index([gtmScopeId, status])
  @@map("crm_sync_records")
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model Deal {
  id                String         @id @default(uuid()) @db.Uuid
  gtmScopeId        String         @map("gtm_scope_id") @db.Uuid
  prospectId        String         @map("prospect_id") @db.Uuid
  name              String         @db.VarChar(160)
  stage             DealStage      @default(PROSPECTING)
  amountUsdMicros   BigInt?        @map("amount_usd_micros")
  closeDateExpected DateTime?      @map("close_date_expected") @db.Date
  closedAt          DateTime?      @map("closed_at") @db.Timestamptz(3)
  gtmScope          GtmScope       @relation(fields: [gtmScopeId], references: [id], onDelete: Cascade)
  prospect          Prospect       @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  // At most one row in practice, enforced by a raw-SQL partial unique index
  // in the migration (invisible to Prisma's own schema types, same as
  // GtmScope's project_id -- see the comment there).
  crmSyncRecords    CrmSyncRecord[]
  // At most one row in practice, enforced by a genuine Prisma-native
  // @unique on CustomerSuccessHandoff.dealId (not a raw-SQL partial index),
  // so this back-relation is correctly singular.
  customerSuccessHandoff CustomerSuccessHandoff?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([gtmScopeId, stage])
  @@index([prospectId])
  @@map("deals")
}

// Durable, auditable record that a Deal reached CLOSED_WON and is ready for
// a CustomerSuccess handoff. Detection only: creating this row does not
// invoke any agent or create any AgentRun -- see apps/orchestrator-worker/
// src/customer-success-handoff-reconciler.ts. Execution wiring (what
// actually invokes CustomerSuccess) is a separate, later increment:
// AgentRun.projectId is required today, and a PLATFORM_GTM deal has no
// Project to hang a run off of.
model CustomerSuccessHandoff {
  id         String   @id @default(uuid()) @db.Uuid
  gtmScopeId String   @map("gtm_scope_id") @db.Uuid
  dealId     String   @unique @map("deal_id") @db.Uuid
  prospectId String   @map("prospect_id") @db.Uuid
  detectedAt DateTime @map("detected_at") @db.Timestamptz(3)
  gtmScope   GtmScope @relation(fields: [gtmScopeId], references: [id], onDelete: Cascade)
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([gtmScopeId, createdAt])
  @@map("customer_success_handoffs")
}