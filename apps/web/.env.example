NEXT_PUBLIC_CONTROL_API_URL=http://localhost:3001
# Required outside development. Microsoft Entra External ID SPA registration.
# NEXT_PUBLIC_ENTRA_CLIENT_ID=11111111-2222-4333-8444-555555555555
# External tenant authority, for example https://atoms.ciamlogin.com/
# NEXT_PUBLIC_ENTRA_AUTHORITY=https://your-tenant-subdomain.ciamlogin.com/
# Delegated scope exposed by the Atoms Control API app registration.
# NEXT_PUBLIC_ENTRA_API_SCOPE=api://66666666-7777-4888-8999-aaaaaaaaaaaa/access_as_user
# Browser-reachable origin used only for presigned attachment transfer.
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9000
# Development only. Use the same random value as AUTH_DEV_ACCESS_TOKEN;
# production must obtain user tokens through Microsoft Entra External ID.
# NEXT_PUBLIC_CONTROL_API_ACCESS_TOKEN=
NEXT_PUBLIC_PREVIEW_BASE_DOMAIN=preview.localhost
